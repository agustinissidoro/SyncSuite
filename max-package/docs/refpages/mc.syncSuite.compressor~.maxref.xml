<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<?xml-stylesheet href="./c74ref.xsl" type="text/xsl"?>

<c74object name="mc.syncSuite.compressor~">

    <digest>
        Feed-forward compressor for speaker layouts.
    </digest>

    <description>
        Detector (peak, or RMS with rms_time) on each channel, optionally through a high-pass (sc_hpf), linked within groups (link_detect: the loudest channel, or the mean power of the group), soft-knee static curve (Giannoulis, Massberg, Reiss 2012), range (most reduction allowed), smooth-branching attack / release on the gain in dB, lookahead delay, mix (parallel). Below the threshold, with mix 0 or with the whole group quiet, the output is the input, delayed by the lookahead, bit for bit. Latency: the lookahead. CPU: about 0.03% of a core per channel at 48 kHz. Built for speaker layouts. LINK GROUPS: every channel belongs to a group (groups attribute; default: all mains in one group, the LFE channels in another). Within a group, link 0..1 blends each channel's own control signal with the group's; at 1 every speaker of the group gets the same gain at every sample, so relative levels, and with them the spatial image, cannot move. EXACT REPORTING: the gain reduction shown and output is the gain actually multiplied into the audio (after linking, ballistics, lookahead and mix), excluding make-up / drive. IMAGE: the input and output energy vectors (Gerzon, from speaker_coords) are compared over 400 ms: the display and the image message give how many degrees the processing turned the image and how much it widened (negative) or narrowed it. DISPLAY: meters (input dim, output bright, gain reduction from the top, hold, link-group colour under each channel), history (the last 10 s of gain reduction per channel, deepest reduction on top), curve (static curve and every channel's operating point), image, statistics (max reduction, share of time reducing, latency). BYPASS keeps the latency and the meters (they show what would be done). Latency is output as latency &lt;samples&gt; &lt;ms&gt; whenever it changes. Nothing is emulated: feed-forward, log-domain gain computer, no saturation.
    </description>

    <!--METADATA-->
    <metadatalist>
        <metadata name="author">Agustin Issidoro</metadata>
        <metadata name="tag">SyncSuite</metadata>
        <metadata name="tag">Dynamics</metadata>
        <metadata name="tag">MSP</metadata>
    </metadatalist>

    <!--MESSAGES-->
    <methodlist>
        <method name="signal">
            <arglist />
            <digest>Speaker feeds, channel i = speaker i</digest>
            <description></description>
        </method>
        <method name="reset">
            <arglist />
            <digest>Clear max values and statistics</digest>
            <description></description>
        </method>
        <method name="get">
            <arglist />
            <digest>Output all measurements</digest>
            <description>gr, gr_max, in_peak_max, out_peak_max (per channel, dB), image (shift deg, width change, azimuth in, azimuth out), stats (max reduction dB, % of time reducing, seconds, clips), latency (samples, ms).</description>
        </method>
    </methodlist>

    <!--ATTRIBUTES-->
    <attributelist>
        <attribute name="speaker_coords" get="1" set="1" type="float64" size="128">
            <digest>Speaker azimuths (deg, 0 = front, clockwise)</digest>
            <description>One per channel, deg, 0 = front, clockwise (as syncSuite.nodes). Empty = even ring of the non-LFE channels. Used for the image and the fold-down.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Layout" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Speaker azimuths (deg, 0 = front, clockwise)" />
            </attributelist>
        </attribute>
        <attribute name="speaker_elevations" get="1" set="1" type="float64" size="128">
            <digest>Speaker elevations (deg)</digest>
            <description>Degrees, up, one per channel (missing = 0). All spatial computations are in 3D; the displays are top views.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Layout" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Speaker elevations (deg)" />
            </attributelist>
        </attribute>
        <attribute name="lfe" get="1" set="1" type="int" size="128">
            <digest>LFE channels (1-based)</digest>
            <description>Not positioned; own group by default.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Layout" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="LFE channels (1-based)" />
            </attributelist>
        </attribute>
        <attribute name="groups" get="1" set="1" type="int" size="128">
            <digest>Link group per channel (empty = mains / LFE)</digest>
            <description>Any integers, one per channel (a shorter list repeats its last value). Empty = mains / LFE.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Layout" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Link group per channel (empty = mains / LFE)" />
            </attributelist>
        </attribute>
        <attribute name="link" get="1" set="1" type="float64" size="1">
            <digest>Link within groups (0 = independent, 1 = same gain)</digest>
            <description>0 = independent channels, 1 = the same gain for the whole group (default).</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Layout" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Link within groups (0 = independent, 1 = same gain)" />
            </attributelist>
        </attribute>
        <attribute name="bypass" get="1" set="1" type="int" size="1">
            <digest>Bypass (latency-aligned, meters keep showing)</digest>
            <description>Output = input (latency-aligned; multiband: the band sum); meters keep showing what would be done. Default: 0.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Bypass (latency-aligned, meters keep showing)" />
            </attributelist>
        </attribute>
        <attribute name="sc_hpf" get="1" set="1" type="float64" size="1">
            <digest>Detector high-pass (Hz, 0 = off)</digest>
            <description>0 = off. 12 dB/oct Butterworth on the detector only.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Detector high-pass (Hz, 0 = off)" />
            </attributelist>
        </attribute>
        <attribute name="threshold" get="1" set="1" type="float64" size="6">
            <digest>Threshold (dB)</digest>
            <description>Default -20.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Threshold (dB)" />
            </attributelist>
        </attribute>
        <attribute name="ratio" get="1" set="1" type="float64" size="6">
            <digest>Ratio</digest>
            <description>Default 4.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Ratio" />
            </attributelist>
        </attribute>
        <attribute name="knee" get="1" set="1" type="float64" size="6">
            <digest>Knee width (dB)</digest>
            <description>Default 6.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Knee width (dB)" />
            </attributelist>
        </attribute>
        <attribute name="attack" get="1" set="1" type="float64" size="6">
            <digest>Attack (ms)</digest>
            <description>Time constant (63 %). Default 10.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Attack (ms)" />
            </attributelist>
        </attribute>
        <attribute name="release" get="1" set="1" type="float64" size="6">
            <digest>Release (ms)</digest>
            <description>Default 150.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Release (ms)" />
            </attributelist>
        </attribute>
        <attribute name="makeup" get="1" set="1" type="float64" size="6">
            <digest>Make-up gain (dB)</digest>
            <description>Not part of the gain reduction. Default: 0.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Make-up gain (dB)" />
            </attributelist>
        </attribute>
        <attribute name="range" get="1" set="1" type="float64" size="6">
            <digest>Most reduction allowed (dB)</digest>
            <description>Most reduction allowed. Default 40.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Most reduction allowed (dB)" />
            </attributelist>
        </attribute>
        <attribute name="detector" get="1" set="1" type="int" size="1">
            <digest>Detector</digest>
            <description>Values: 0 = peak, 1 = rms (a number or the name). Default: 0.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Detector" />
                <attribute name="style" get="1" set="1" type="symbol" size="1" value="enumindex" />
                <attribute name="enumvals" get="1" set="1" type="atom" size="2">
                    <enumlist>
                        <enum name="peak"><digest>peak</digest></enum>
                        <enum name="rms"><digest>rms</digest></enum>
                    </enumlist>
                </attribute>
            </attributelist>
        </attribute>
        <attribute name="rms_time" get="1" set="1" type="float64" size="1">
            <digest>RMS time constant (ms)</digest>
            <description>Default 20.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="RMS time constant (ms)" />
            </attributelist>
        </attribute>
        <attribute name="link_detect" get="1" set="1" type="int" size="1">
            <digest>Group level</digest>
            <description>Values: 0 = loudest, 1 = mean_power (a number or the name). Default: 0.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Group level" />
                <attribute name="style" get="1" set="1" type="symbol" size="1" value="enumindex" />
                <attribute name="enumvals" get="1" set="1" type="atom" size="2">
                    <enumlist>
                        <enum name="loudest"><digest>loudest</digest></enum>
                        <enum name="mean_power"><digest>mean_power</digest></enum>
                    </enumlist>
                </attribute>
            </attributelist>
        </attribute>
        <attribute name="lookahead" get="1" set="1" type="float64" size="1">
            <digest>Lookahead (ms)</digest>
            <description>Default 0.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Lookahead (ms)" />
            </attributelist>
        </attribute>
        <attribute name="mix" get="1" set="1" type="float64" size="1">
            <digest>Mix (1 = all compressed)</digest>
            <description>1 = all compressed, 0 = dry (latency-aligned).</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Dynamics" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Mix (1 = all compressed)" />
            </attributelist>
        </attribute>
        <attribute name="view" get="1" set="1" type="int" size="1">
            <digest>View</digest>
            <description>Which panels are drawn: all, or one of them filling the box. Values: 0 = all, 1 = meters, 2 = history, 3 = curve, 4 = image (a number or the name). Default: 0.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Display" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="View" />
                <attribute name="style" get="1" set="1" type="symbol" size="1" value="enumindex" />
                <attribute name="enumvals" get="1" set="1" type="atom" size="5">
                    <enumlist>
                        <enum name="all"><digest>all</digest></enum>
                        <enum name="meters"><digest>meters</digest></enum>
                        <enum name="history"><digest>history</digest></enum>
                        <enum name="curve"><digest>curve</digest></enum>
                        <enum name="image"><digest>image</digest></enum>
                    </enumlist>
                </attribute>
            </attributelist>
        </attribute>
        <attribute name="gr_range" get="1" set="1" type="float64" size="1">
            <digest>Gain reduction scale (dB)</digest>
            <description></description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Display" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Gain reduction scale (dB)" />
            </attributelist>
        </attribute>
        <attribute name="meter_min" get="1" set="1" type="float64" size="1">
            <digest>Meter floor (dB)</digest>
            <description>Default: -60.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Display" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Meter floor (dB)" />
            </attributelist>
        </attribute>
        <attribute name="select" get="1" set="1" type="int" size="1">
            <digest>Highlighted channel (0 = none)</digest>
            <description>Also by clicking a meter. Default: 0.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Display" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Highlighted channel (0 = none)" />
            </attributelist>
        </attribute>
        <attribute name="select_band" get="1" set="1" type="int" size="1">
            <digest>Band shown in the curve</digest>
            <description>Default: 1.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Display" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Band shown in the curve" />
            </attributelist>
        </attribute>
        <attribute name="bypass_ui" get="1" set="1" type="int" size="1">
            <digest>Stop drawing (audio unaffected)</digest>
            <description>1: nothing is drawn and the display timer stops; the audio and the message output are not affected (use it when the box is hidden or while performing). Default: 0.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Display" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Stop drawing (audio unaffected)" />
            </attributelist>
        </attribute>
        <attribute name="no_ui" get="1" set="1" type="int" size="1">
            <digest>No UI: a plain object box (set it when typing the object: @no_ui 1)</digest>
            <description>Type it with the object (mc.syncSuite.limiter~ @no_ui 1): the box looks and sizes like a standard object box, draws nothing, runs no display timer and skips the display-only metering. Max decides per class whether a box is a UI box, so the box stays resizable, but it behaves as a standard object: audio, messages and get work as usual. Default: 0.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Display" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="No UI: a plain object box (set it when typing the object: @no_ui 1)" />
            </attributelist>
        </attribute>
        <attribute name="output" get="1" set="1" type="int" size="1">
            <digest>Output measurements every frame</digest>
            <description>1: the measurements (see get) are output at every display refresh with new data. 0: only on get.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Display" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Output measurements every frame" />
            </attributelist>
        </attribute>
        <attribute name="interval" get="1" set="1" type="int" size="1">
            <digest>Refresh interval (ms)</digest>
            <description>Display refresh and output rate. The processing does not depend on it. Default: 33.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Display" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Refresh interval (ms)" />
            </attributelist>
        </attribute>
        <attribute name="bgcolor" get="1" set="1" type="float64" size="4">
            <digest>Background Color</digest>
            <description>Box background (syncSuite style: near black).</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Color" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Background Color" />
                <attribute name="style" get="1" set="1" type="symbol" size="1" value="rgba" />
            </attributelist>
        </attribute>
        <attribute name="panelcolor" get="1" set="1" type="float64" size="4">
            <digest>Panel Color</digest>
            <description>Panel background.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Color" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Panel Color" />
                <attribute name="style" get="1" set="1" type="symbol" size="1" value="rgba" />
            </attributelist>
        </attribute>
        <attribute name="textcolor" get="1" set="1" type="float64" size="4">
            <digest>Text Color</digest>
            <description>Labels and numbers.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Color" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Text Color" />
                <attribute name="style" get="1" set="1" type="symbol" size="1" value="rgba" />
            </attributelist>
        </attribute>
        <attribute name="gridcolor" get="1" set="1" type="float64" size="4">
            <digest>Grid Color</digest>
            <description>Scales and guides.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Color" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Grid Color" />
                <attribute name="style" get="1" set="1" type="symbol" size="1" value="rgba" />
            </attributelist>
        </attribute>
        <attribute name="color" get="1" set="1" type="float64" size="4">
            <digest>Signal Color</digest>
            <description>Main signal colour (syncSuite hot pink).</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Color" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Signal Color" />
                <attribute name="style" get="1" set="1" type="symbol" size="1" value="rgba" />
            </attributelist>
        </attribute>
        <attribute name="grcolor" get="1" set="1" type="float64" size="4">
            <digest>Gain Reduction Color</digest>
            <description>Gain reduction bars and curve.</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Color" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Gain Reduction Color" />
                <attribute name="style" get="1" set="1" type="symbol" size="1" value="rgba" />
            </attributelist>
        </attribute>
        <attribute name="overcolor" get="1" set="1" type="float64" size="4">
            <digest>Over Color</digest>
            <description>Overs and clips (acid yellow).</description>
            <attributelist>
                <attribute name="category" get="1" set="1" type="symbol" size="1" value="Color" />
                <attribute name="label" get="1" set="1" type="symbol" size="1" value="Over Color" />
                <attribute name="style" get="1" set="1" type="symbol" size="1" value="rgba" />
            </attributelist>
        </attribute>
    </attributelist>

    <!--INLETS-->
    <inletlist>
        <inlet id="0" type="multichannelsignal">
            <digest>Speaker feeds and messages</digest>
        </inlet>
    </inletlist>

    <!--OUTLETS-->
    <outletlist>
        <outlet id="0" type="multichannelsignal">
            <digest>Processed speaker feeds (same channels as the input)</digest>
        </outlet>
        <outlet id="1" type="list">
            <digest>Measurements</digest>
        </outlet>
    </outletlist>

    <!--SEEALSO-->
    <seealsolist>
        <seealso name="mc.syncSuite.limiter~" />
        <seealso name="mc.syncSuite.compressor~" />
        <seealso name="mc.syncSuite.multiband~" />
        <seealso name="mc.syncSuite.analyzer~" />
        <seealso name="syncSuite.nodes" />
    </seealsolist>

</c74object>
